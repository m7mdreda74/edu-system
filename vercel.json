{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/storage/(avatars|thumbnails)/(.*)",
            "dest": "/storage/$1/$2"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/api/index.php"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/api/blob-upload",
            "dest": "/api/blob-upload.js"
        },
        {
            "src": "/api/blob-download",
            "dest": "/api/blob-download.js"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/live-session-reminders",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/subscription-renewal-reminders",
            "schedule": "0 0 * * *"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "JITSI_DOMAIN": "meet.element.io",
        "JITSI_REQUIRE_AUTH": "false",
        "CACHE_STORE": "file",
        "CACHE_PATH": "/tmp/framework/cache/data",
        "CACHE_LOCK_PATH": "/tmp/framework/cache/data",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "VIEW_COMPILED_PATH": "/tmp/views"
    }
}
